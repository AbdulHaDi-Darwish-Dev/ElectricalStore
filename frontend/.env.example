# ElectricalStore frontend — local development examples
# Copy to .env.local and adjust. Do not commit secrets.
#
# Official local ports (see docs/DEVELOPMENT-GUIDE.md):
#   Frontend: http://localhost:3100
#   API:      http://localhost:5180

# Server-side ASP.NET base URL (Server Components / auth BFF handlers)
API_BASE_URL=http://localhost:5180

# Browser-side ASP.NET base URL (direct fetch where allowed by CORS)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5180

# Public site origin (metadata, robots, sitemap, same-origin checks)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Optional server-only site origin for same-origin checks (falls back to NEXT_PUBLIC_SITE_URL)
# SITE_URL=http://localhost:3100

# Email verification links are built by the API using Email:FrontendPublicUrl
# (typically the same as NEXT_PUBLIC_SITE_URL). Configure on the API host, not here.
