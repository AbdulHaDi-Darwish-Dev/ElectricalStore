# ElectricalStore frontend — local development examples
# Copy to .env.local and adjust. Do not commit secrets.

# Server-side ASP.NET base URL (Server Components / future auth handlers)
API_BASE_URL=http://localhost:5080

# Browser-side ASP.NET base URL (direct fetch where allowed by CORS)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Public site origin (metadata, robots, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only site origin for same-origin checks (falls back to NEXT_PUBLIC_SITE_URL)
# SITE_URL=http://localhost:3000
