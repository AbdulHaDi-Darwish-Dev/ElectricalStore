{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "ElectricalStore": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3100" ]
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": []
  },
  "ConnectionStrings": {
    "Default": "Server=DESKTOP-30CDIBP\\MSSQLSERVER22;Database=ElectricalStore.Db;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Permixa": {
    "Jwt": {
      "Issuer": "https://electricalstore.local",
      "Audience": "electricalstore-api"
    },
    "Bootstrap": {
      "Enabled": true,
      "OwnerEmail": "owner@electricalstore.local",
      "OwnerUserName": "owner"
    },
    "Authentication": {
      "RequireConfirmedEmail": true
    },
    "AppSeed": {
      "Enabled": true
    }
  },
  "LocalDevFixtures": {
    "Enabled": true
  },
  "DemoCatalog": {
    "Enabled": true,
    "PublicBaseUrl": "http://localhost:5180"
  },
  "Email": {
    "FrontendPublicUrl": "http://localhost:3100",
    "FromEmail": "noreply@electricalstore.local",
    "FromName": "ElectricalStore",
    "UseCapturingSender": true,
    "Branding": {
      "ApplicationName": "ElectricalStore",
      "CompanyName": "",
      "SupportEmail": ""
    },
    "Resend": {
      "ApiKey": ""
    }
  },
  "Media": {
    "AllowLocalDevStorage": true
  }
}
