# Production environment template — copy to repo-root `.env.production` (gitignored).
# Never commit real secrets, PEMs, or passwords.

# Public hostname (TLS / nginx server_name). No scheme.
STORE_HOST=store.example.com

# Optional: only needed if browser calls a *different* origin than STORE_HOST.
# Same-origin /aspnet routing usually leaves this empty (deny-by-default CORS).
# Cors__AllowedOrigins__0=https://store.example.com

# SQL (container on private network 10.80.0.40 — not published)
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_Password_Here
ConnectionStrings__Default=Server=sqlserver,1433;Database=ElectricalStore;User Id=sa;Password=CHANGE_ME_Strong_Password_Here;TrustServerCertificate=True;Encrypt=True

# Permixa JWT (PEM contents; use \n escapes or mount secrets via your orchestrator)
Permixa__Jwt__Issuer=https://store.example.com
Permixa__Jwt__Audience=electricalstore-api
Permixa__Jwt__PrivateKeyPem=
Permixa__Jwt__PublicKeyPem=

# Cloudinary (required for media uploads; catalog can run without)
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# Email verification (Resend) — required when Permixa__Authentication__RequireConfirmedEmail=true
Permixa__Authentication__RequireConfirmedEmail=true
Email__FrontendPublicUrl=https://store.example.com
Email__FromEmail=noreply@store.example.com
Email__FromName=ElectricalStore
Email__UseCapturingSender=false
Email__Branding__ApplicationName=ElectricalStore
Email__Branding__CompanyName=
Email__Branding__SupportEmail=
Email__Resend__ApiKey=
# Optional overrides (defaults: UrlToken 60 minutes, ResendCooldown 60 seconds)
# Email__UrlTokenLifetimeMinutes=60
# Email__ResendCooldownSeconds=60
