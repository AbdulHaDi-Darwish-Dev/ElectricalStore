worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 12m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream frontend_upstream {
        server frontend:3000;
    }

    upstream api_upstream {
        server api:8080;
    }

    # HTTP → HTTPS
    server {
        listen 80;
        listen [::]:80;
        server_name ${STORE_HOST};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name ${STORE_HOST};

        # Mount Let's Encrypt or operator-provisioned certs (never commit private keys).
        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        # Baseline security headers (HTTPS only)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        # CSP deferred — Next.js needs a carefully tested policy.

        # Overwrite forwarding headers (do NOT use $proxy_add_x_forwarded_for).
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-ElectricalStore-Client-Ip $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Same-origin ASP.NET path (strip /aspnet prefix).
        location /aspnet/ {
            proxy_pass http://api_upstream/;
            proxy_read_timeout 60s;
        }

        location / {
            proxy_pass http://frontend_upstream;
            proxy_read_timeout 60s;
        }
    }
}
